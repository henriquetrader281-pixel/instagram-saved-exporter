{
  "manifest_version": 3,
  "name": "Instagram Saved Exporter",
  "version": "3.0.0",
  "description": "Exporta os itens salvos do Instagram (dataset local para ML) lendo diretamente o que está renderizado na página, sem depender de endpoints internos.",
  "permissions": ["storage", "downloads", "tabs", "alarms"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Instagram Saved Exporter"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*/saved/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/p/*",
        "https://www.instagram.com/reel/*"
      ],
      "js": ["post-reader.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
